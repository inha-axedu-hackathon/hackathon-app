# 이 파일을 .env.local로 복사하고 값을 채운다. .env.local은 저장소에 올라가지 않는다.
# 안뇽GPT(해커톤 AI 크레딧, BAZE 게이트웨이). 키가 비어 있으면 API는 키워드·저장본으로 동작한다.
LLM_BASE_URL=https://api.baze.co/v1/gateway
LLM_API_KEY=
# 생각(thinking)을 끌 수 있는 모델만 쓴다. 권장: claude-haiku-5-5
LLM_MODEL=

# 선택: 하루 AI 토큰 상한(비우면 100000). 넘으면 AI 없이 키워드·저장본으로 간다
LLM_DAILY_TOKENS=
# 선택: 1이면 AI를 아예 부르지 않는다(비상 스위치)
LLM_DISABLED=
# 선택: 1이면 배포 주소에서도 /api/analyze를 연다(비우면 로컬 npm run dev에서만)
ANALYZE_ENABLED=
